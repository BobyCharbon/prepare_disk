<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.bobycharbon.preparedisk.agent</string>
    <key>BundleProgram</key><string>Contents/MacOS/PrepareDisk</string>
    <key>ProgramArguments</key>
    <array><string>PrepareDisk</string><string>--agent</string></array>
    <!-- Icône dans la barre des menus : lancée à l'ouverture de session et relancée si elle s'arrête. -->
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>LimitLoadToSessionType</key><string>Aqua</string>
    <key>ProcessType</key><string>Interactive</string>
</dict>
</plist>
